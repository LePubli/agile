# ==================== ENVIRONNEMENT NEXUSOS ====================
# Copiez ce fichier en .env et personnalisez les valeurs

# ==================== DATABASE ====================
POSTGRES_USER=nexusos
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD_123!
POSTGRES_DB=nexusos

# ==================== REDIS ====================
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_456!

# ==================== MINIO (S3) ====================
MINIO_ROOT_USER=nexusos_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD_789!
MINIO_BUCKET=nexusos-assets
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ==================== OPENSEARCH (Optionnel) ====================
OPENSEARCH_PASSWORD=Admin123!

# ==================== SECURITY ====================
JWT_SECRET=CHANGE_ME_SUPER_SECURE_JWT_SECRET_MIN_32_CHARS
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY_MIN_32_CHARS

# ==================== AI PROVIDERS ====================
AI_OPENAI_API_KEY=sk-your-openai-api-key
AI_ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
AI_MISTRAL_API_KEY=your-mistral-api-key

# ==================== API CONFIG ====================
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com/ws

# ==================== WORKER CONFIG ====================
WORKER_CONCURRENCY=5

# ==================== DOMAIN (Pour Coolify) ====================
DOMAIN=yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# ==================== LOGGING ====================
LOG_LEVEL=info

# ==================== SWAGGER ====================
ENABLE_SWAGGER=true
