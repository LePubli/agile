# ============================================
# NEXUSOS - FICHIER DE VARIABLES D'ENVIRONNEMENT
# ============================================
# Copiez ce fichier en .env et personnalisez les valeurs
# Commande: cp .env.example .env

# ============================================
# BASE DE DONNÉES (PostgreSQL)
# ============================================
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_secure_password_change_me_2024
POSTGRES_DB=nexus_db

# ============================================
# REDIS (Cache & Message Broker)
# ============================================
REDIS_PASSWORD=nexus_redis_password_change_me_2024

# ============================================
# MINIO (Stockage Objet S3)
# ============================================
MINIO_ACCESS_KEY=nexusadmin
MINIO_SECRET_KEY=nexus_secure_minio_change_me_2024
MINIO_BUCKET=nexus-uploads
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ============================================
# OPENSEARCH (Recherche & Logs)
# ============================================
OPENSEARCH_PASSWORD=nexus_os_password_change_me_2024

# ============================================
# SÉCURITÉ & JWT
# ============================================
# Générez une clé secrète forte avec: openssl rand -base64 32
JWT_SECRET=votre_jwt_secret_super_long_et_securise_change_en_production_2024
REFRESH_TOKEN_SECRET=votre_refresh_token_secret_change_en_production_2024
JWT_EXPIRES_IN=24h

# ============================================
# PROVIDERS IA (Optionnel mais recommandé)
# ============================================
OPENAI_API_KEY=sk-votre_cle_openai
ANTHROPIC_API_KEY=sk-ant-votre_cle_anthropic
MISTRAL_API_KEY=votre_cle_mistral

# ============================================
# EMAIL / SMTP (Optionnel)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_app
SMTP_FROM=NexusOS <noreply@votre-domaine.com>

# ============================================
# URLS & PORTS
# ============================================
APP_URL=https://votre-app.domaine.com
API_URL=https://api.votre-domaine.com
FRONTEND_URL=https://votre-app.domaine.com
WS_URL=wss://api.votre-domaine.com

# Ports exposés (pour dev local)
API_PORT=4000
WEB_PORT=3000

# ============================================
# WORKERS CONFIGURATION
# ============================================
WORKER_CONCURRENCY=5
WORKER_REPLICAS=2

# Activer/désactiver les types de workers
WORKER_EMAIL_ENABLED=true
WORKER_AI_ENABLED=true
WORKER_WORKFLOW_ENABLED=true
WORKER_ENRICHMENT_ENABLED=true
WORKER_SCRAPING_ENABLED=true

# ============================================
# APPLICATION
# ============================================
NODE_ENV=production
LOG_LEVEL=info
NEXT_PUBLIC_APP_NAME=NexusOS

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
