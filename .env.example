# ===========================================
# NexusOS Environment Configuration
# ===========================================

# Application
NODE_ENV=production
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database (PostgreSQL)
DB_USER=nexusos
DB_PASSWORD=nexusos_secret_password_change_in_production
DB_NAME=nexusos
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=nexusos_redis_secret_change_in_production

# MinIO (S3-compatible Object Storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=nexusos_minio_admin
MINIO_SECRET_KEY=nexusos_minio_secret_key_change_me
MINIO_BUCKET=nexusos-assets
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# OpenSearch (Elasticsearch alternative)
OPENSEARCH_NODE=http://opensearch:9200
OPENSEARCH_PASSWORD=nexusos_opensearch_admin

# Security
JWT_SECRET=nexusos_jwt_super_secret_key_change_in_production_64chars_minimum
ENCRYPTION_KEY=nexusos_encryption_32_chars_key!!

# AI Providers (optional - configure as needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# Workers
WORKER_REPLICAS=2

# Ports
PORT=4000
