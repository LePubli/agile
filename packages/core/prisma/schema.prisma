// Prisma Schema for NexusOS
// Multi-tenant SaaS ERP/CRM Platform

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== CORE TENANT SYSTEM ====================

/// Tenant (Organization/Company)
model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  status      TenantStatus @default(ACTIVE)
  plan        PlanType @default(FREE)
  domain      String?  @unique
  logo        String?
  settings    Json     @default("{}")
  metadata    Json     @default("{}")
  
  // Quotas & Limits
  maxUsers    Int      @default(5)
  maxStorage  BigInt   @default(1073741824) // 1GB in bytes
  credits     Int      @default(1000)
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  
  // Relations
  users       User[]
  workspaces  Workspace[]
  plugins     TenantPlugin[]
  subscriptions Subscription[]
  apiKeys     ApiKey[]
  auditLogs   AuditLog[]
  
  @@index([slug])
  @@index([status])
  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING
  DELETED
}

enum PlanType {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

/// Workspace (Sub-organization within tenant)
model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  settings    Json     @default("{}")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  users       UserWorkspace[]
  
  @@unique([tenantId, slug])
  @@map("workspaces")
}

// ==================== USER MANAGEMENT ====================

model User {
  id            String    @id @default(cuid())
  email         String
  passwordHash  String?
  firstName     String?
  lastName      String?
  avatar        String?
  status        UserStatus @default(PENDING)
  
  // Multi-tenant
  tenants       UserTenant[]
  workspaces    UserWorkspace[]
  
  // Security
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String?
  lastLoginAt   DateTime?
  lastLoginIp   String?
  
  // Preferences
  timezone      String    @default("UTC")
  language      String    @default("en")
  theme         String    @default("default")
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  
  // Relations
  apiKey        ApiKey[]
  sessions      Session[]
  auditLogs     AuditLog[]
  
  @@unique([email])
  @@index([status])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

model UserTenant {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      RoleType
  isActive  Boolean  @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, tenantId])
  @@map("user_tenants")
}

model UserWorkspace {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        RoleType
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([userId, workspaceId])
  @@map("user_workspaces")
}

enum RoleType {
  OWNER
  ADMIN
  MEMBER
  VIEWER
  GUEST
}

// ==================== AUTHENTICATION ====================

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  refreshToken String?  @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  
  @@index([token])
  @@index([userId])
  @@map("sessions")
}

model ApiKey {
  id          String   @id @default(cuid())
  name        String
  key         String   @unique
  secret      String
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String[] 
  rateLimit   Int      @default(1000) // requests per hour
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([key])
  @@index([tenantId])
  @@map("api_keys")
}

// ==================== PLUGIN SYSTEM ====================

model Plugin {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  version     String
  author      String?
  repository  String?
  homepage    String?
  icon        String?
  category    PluginCategory
  manifest    Json     // Full plugin.json content
  isActive    Boolean  @default(true)
  
  // Dependencies
  dependencies String[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  tenantPlugins TenantPlugin[]
  pluginHooks   PluginHook[]
  
  @@index([category])
  @@index([isActive])
  @@map("plugins")
}

enum PluginCategory {
  CRM
  MARKETING
  SALES
  ANALYTICS
  AUTOMATION
  AI
  COMMUNICATION
  INTEGRATION
  UTILITY
  THEME
}

model TenantPlugin {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pluginId    String
  plugin      Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  isEnabled   Boolean  @default(false)
  config      Json     @default("{}")
  version     String
  
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([tenantId, pluginId])
  @@index([tenantId])
  @@index([isEnabled])
  @@map("tenant_plugins")
}

model PluginHook {
  id          String   @id @default(cuid())
  pluginId    String
  plugin      Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  hookType    HookType
  handler     String   // Function/handler name
  priority    Int      @default(0)
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  
  @@index([pluginId])
  @@index([hookType])
  @@map("plugin_hooks")
}

enum HookType {
  ROUTE
  MENU
  WIDGET
  EVENT_LISTENER
  WORKFLOW_ACTION
  API_ENDPOINT
  UI_COMPONENT
  DATABASE_MODEL
}

// ==================== EVENT BUS ====================

model Event {
  id          String   @id @default(cuid())
  type        String
  source      String
  tenantId    String?
  payload     Json
  metadata    Json     @default("{}")
  processed   Boolean  @default(false)
  processedAt DateTime?
  
  createdAt   DateTime @default(now())
  
  // Relations
  eventSubscriptions EventSubscription[]
  auditLogs          AuditLog[]
  
  @@index([type])
  @@index([tenantId])
  @@index([processed])
  @@index([createdAt])
  @@map("events")
}

model EventSubscription {
  id          String   @id @default(cuid())
  eventId     String?
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventType   String
  subscriberId String  // Plugin ID or service name
  handler     String
  filter      Json?    // Event filter conditions
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([eventType])
  @@index([subscriberId])
  @@map("event_subscriptions")
}

// ==================== WORKFLOW ENGINE ====================

model Workflow {
  id          String   @id @default(cuid())
  name        String
  description String?
  tenantId    String?
  trigger     Json     // Trigger configuration
  steps       Json     // Array of workflow steps
  isActive    Boolean  @default(false)
  isSystem    Boolean  @default(false)
  
  // Statistics
  runCount    Int      @default(0)
  successCount Int     @default(0)
  failureCount Int     @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  executions  WorkflowExecution[]
  
  @@index([tenantId])
  @@index([isActive])
  @@map("workflows")
}

model WorkflowExecution {
  id          String   @id @default(cuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status      ExecutionStatus @default(PENDING)
  context     Json     @default("{}")
  currentStep Int      @default(0)
  error       String?
  
  startedAt   DateTime @default(now())
  completedAt DateTime?
  
  // Relations
  logs        WorkflowLog[]
  
  @@index([workflowId])
  @@index([status])
  @@index([startedAt])
  @@map("workflow_executions")
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model WorkflowLog {
  id          String   @id @default(cuid())
  executionId String
  execution   WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  step        Int
  action      String
  status      String
  input       Json?
  output      Json?
  error       String?
  
  createdAt   DateTime @default(now())
  
  @@index([executionId])
  @@map("workflow_logs")
}

// ==================== AUDIT LOGGING ====================

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  resource    String
  resourceId  String?
  changes     Json?
  ipAddress   String?
  userAgent   String?
  eventId     String?
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  
  createdAt   DateTime @default(now())
  
  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==================== BILLING & SUBSCRIPTIONS ====================

model Subscription {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan        PlanType
  status      SubscriptionStatus @default(ACTIVE)
  
  // Billing
  price       Decimal
  currency    String   @default("USD")
  interval    BillingInterval @default(MONTHLY)
  
  // Period
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  
  // Payment
  paymentMethod String?
  lastPaymentAt DateTime?
  nextBillingAt DateTime?
  
  // Metadata
  metadata    Json     @default("{}")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cancelledAt DateTime?
  
  @@index([tenantId])
  @@index([status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  type        NotificationType
  title       String
  message     String
  data        Json?
  isRead      Boolean  @default(false)
  readAt      DateTime?
  
  createdAt   DateTime @default(now())
  
  @@index([tenantId])
  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
  SYSTEM
}

// ==================== JOBS & QUEUES ====================

model Job {
  id          String   @id @default(cuid())
  queue       String
  type        String
  data        Json
  status      JobStatus @default(PENDING)
  priority    Int      @default(0)
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  
  // Timing
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  
  // Result
  result      Json?
  error       String?
  
  // Metadata
  tenantId    String?
  workerId    String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([queue])
  @@index([status])
  @@index([scheduledAt])
  @@index([tenantId])
  @@map("jobs")
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// ==================== FILE STORAGE ====================

model File {
  id          String   @id @default(cuid())
  tenantId    String
  filename    String
  originalName String
  mimeType    String
  size        BigInt
  path        String
  bucket      String   @default("nexusos-assets")
  url         String?
  metadata    Json?
  
  uploadedBy  String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([tenantId])
  @@index([bucket])
  @@map("files")
}

// ==================== AI & TOKENS ====================

model AiUsage {
  id          String   @id @default(cuid())
  tenantId    String
  provider    AiProvider
  model       String
  action      String
  tokensIn    Int
  tokensOut   Int
  cost        Decimal
  duration    Int      // milliseconds
  
  metadata    Json?
  
  createdAt   DateTime @default(now())
  
  @@index([tenantId])
  @@index([provider])
  @@index([createdAt])
  @@map("ai_usage")
}

enum AiProvider {
  OPENAI
  ANTHROPIC
  MISTRAL
  LOCAL
}

// ==================== INDEXES FOR PERFORMANCE ====================

// Composite indexes for common queries
@@index([Tenant.status, Tenant.plan])
@@index([User.status, User.deletedAt])
@@index([Workflow.tenantId, Workflow.isActive])
@@index([Job.status, Job.queue, Job.scheduledAt])
