{
  "name": "nexus-crm",
  "version": "1.0.0",
  "displayName": "CRM Module",
  "description": "Customer Relationship Management complet avec pipeline, leads, companies et deals",
  "author": "NexusOS Team",
  "license": "MIT",
  "homepage": "https://nexusos.com/plugins/crm",
  "repository": "github:nexusos/plugin-crm",
  
  "engine": {
    "backend": ">=1.0.0",
    "frontend": ">=1.0.0"
  },
  
  "dependencies": [
    "nexus-core@>=1.0.0",
    "nexus-auth@>=1.0.0"
  ],
  
  "optionalDependencies": [
    "nexus-email@>=1.0.0",
    "nexus-workflows@>=1.0.0",
    "nexus-ai-engine@>=1.0.0"
  ],
  
  "routes": [
    {
      "path": "/api/crm",
      "methods": ["GET", "POST", "PUT", "DELETE"]
    },
    {
      "path": "/crm",
      "type": "page",
      "component": "DashboardPage"
    },
    {
      "path": "/crm/leads",
      "type": "page",
      "component": "LeadsPage"
    },
    {
      "path": "/crm/companies",
      "type": "page",
      "component": "CompaniesPage"
    },
    {
      "path": "/crm/deals",
      "type": "page",
      "component": "DealsPage"
    },
    {
      "path": "/crm/pipeline",
      "type": "page",
      "component": "PipelinePage"
    }
  ],
  
  "permissions": [
    "crm:read",
    "crm:write",
    "crm:delete",
    "crm:export",
    "crm:pipeline:manage"
  ],
  
  "menus": [
    {
      "id": "crm-main",
      "label": "CRM",
      "icon": "users",
      "order": 10,
      "children": [
        {"id": "crm-leads", "label": "Leads", "route": "/crm/leads", "icon": "user-plus"},
        {"id": "crm-companies", "label": "Companies", "route": "/crm/companies", "icon": "building"},
        {"id": "crm-deals", "label": "Deals", "route": "/crm/deals", "icon": "dollar-sign"},
        {"id": "crm-pipeline", "label": "Pipeline", "route": "/crm/pipeline", "icon": "trello"}
      ]
    }
  ],
  
  "widgets": [
    {
      "id": "pipeline-widget",
      "name": "Pipeline View",
      "component": "PipelineWidget",
      "location": "dashboard",
      "size": "large"
    },
    {
      "id": "recent-leads-widget",
      "name": "Recent Leads",
      "component": "RecentLeadsWidget",
      "location": "dashboard",
      "size": "medium"
    },
    {
      "id": "deals-won-widget",
      "name": " Deals Won",
      "component": "DealsWonWidget",
      "location": "dashboard",
      "size": "small"
    }
  ],
  
  "events": {
    "emits": [
      "lead.created",
      "lead.updated",
      "lead.deleted",
      "company.created",
      "company.updated",
      "deal.won",
      "deal.lost",
      "pipeline.stage.changed"
    ],
    "listens": [
      "email.received",
      "email.sent",
      "task.completed",
      "ai.enrichment.completed"
    ]
  },
  
  "hooks": {
    "beforeInstall": "scripts/beforeInstall.ts",
    "afterInstall": "scripts/afterInstall.ts",
    "beforeUninstall": "scripts/beforeUninstall.ts",
    "afterUpdate": "scripts/afterUpdate.ts"
  },
  
  "settings": {
    "schema": {
      "pipelineStages": {
        "type": "array",
        "default": ["New", "Contacted", "Qualified", "Proposal", "Negotiation", "Won", "Lost"],
        "items": {"type": "string"}
      },
      "autoAssign": {
        "type": "boolean",
        "default": false
      },
      "leadScoring": {
        "type": "object",
        "properties": {
          "enabled": {"type": "boolean", "default": false},
          "threshold": {"type": "number", "default": 50}
        }
      },
      "dealCurrency": {
        "type": "string",
        "default": "USD"
      }
    }
  },
  
  "migrations": [
    "migrations/001_initial.sql",
    "migrations/002_add_custom_fields.sql",
    "migrations/003_add_lead_scoring.sql"
  ],
  
  "locales": ["en", "fr", "es", "de"],
  
  "screenshots": [
    "/assets/screenshots/dashboard.png",
    "/assets/screenshots/pipeline.png",
    "/assets/screenshots/leads.png"
  ]
}
